# Floating-point tensors the graph stores, as initializers or inside Constant
# nodes, with their dimensions: one row per axis (a scalar has one row, no axis).
PREFIX lmnf: <https://metavacua.github.io/lm-normal-form/ns#>
SELECT ?tensor ?axis ?size WHERE {
  { ?tensor a lmnf:Initializer } UNION { ?tensor a lmnf:Tensor }
  ?tensor lmnf:elemType ?type .
  FILTER(?type IN ("FLOAT", "FLOAT16", "DOUBLE", "BFLOAT16"))
  OPTIONAL { ?tensor lmnf:dim ?d . ?d lmnf:axis ?axis ; lmnf:size ?size }
}
ORDER BY ?tensor ?axis
