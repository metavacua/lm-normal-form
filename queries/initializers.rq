# Initializers: how many, how many elements, how many bytes. A tensor kept in
# another file, or one of strings, has elements and no bytes here.
PREFIX lmnf: <https://metavacua.github.io/lm-normal-form/ns#>
SELECT (COUNT(?v) AS ?count) (SUM(?e) AS ?elements) (SUM(COALESCE(?b, 0)) AS ?bytes) WHERE {
  ?v a lmnf:Initializer ; lmnf:elementCount ?e .
  OPTIONAL { ?v lmnf:byteLength ?b }
}
