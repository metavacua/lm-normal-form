import Mathlib
import LmnfNormal.Canon

/-!
# A normal form for tuples under a gauge on the items and a permutation of the positions

An `n`-tuple is a function `f : Fin n → U` (Wikipedia "Tuple": an `n`-tuple is a function whose
domain is the first `n` natural numbers).  A `Move` either permutes the positions of the tuple or
applies a gauge element `c i : Γ` to the item at position `i`, separately for each `i`.
`TEquiv act` is the equivalence relation that the moves generate.

An `ItemNormalizer act norm` is a map `norm : U → U` that is constant on the orbits of the gauge
action `act` and sends every item to an element of its orbit.  Given an injective `key` into a
linear order, `NF key norm f` normalizes every item and then sorts the items by their keys.
This is a canonicalization (`LmnfNormal.Canonicalization`) of `TEquiv act`.
-/

namespace LmnfNormal

variable {n : ℕ} {U Γ β : Type*}

/-- One move on tuples: a permutation of the positions, or a gauge element applied to each item. -/
inductive Move (act : Γ → U → U) : (Fin n → U) → (Fin n → U) → Prop
  | perm (f : Fin n → U) (σ : Equiv.Perm (Fin n)) : Move act f (f ∘ σ)
  | gauge (f : Fin n → U) (c : Fin n → Γ) : Move act f (fun i => act (c i) (f i))

/-- The equivalence relation on tuples generated by the moves. -/
def TEquiv (act : Γ → U → U) : (Fin n → U) → (Fin n → U) → Prop :=
  Relation.EqvGen (Move act)

/-- `norm` is constant on the orbits of the action `act` and sends every item into its orbit. -/
structure ItemNormalizer (act : Γ → U → U) (norm : U → U) : Prop where
  /-- `norm` is constant along the action. -/
  invariant : ∀ γ x, norm (act γ x) = norm x
  /-- `norm x` lies in the orbit of `x`. -/
  representative : ∀ x, ∃ γ, norm x = act γ x

/-- The normal form of a tuple: normalize each item, then sort the items by their keys. -/
def NF [LinearOrder β] (key : U → β) (norm : U → U) (f : Fin n → U) : Fin n → U :=
  (norm ∘ f) ∘ Tuple.sort (key ∘ norm ∘ f)

/-- `TEquiv act` is an equivalence relation. -/
theorem tequiv_equivalence (act : Γ → U → U) : Equivalence (TEquiv (n := n) act) :=
  ⟨fun f => Relation.EqvGen.refl (r := Move act) f,
    fun h => Relation.EqvGen.symm (r := Move act) _ _ h,
    fun h₁ h₂ => Relation.EqvGen.trans (r := Move act) _ _ _ h₁ h₂⟩

/-- A normalizer is idempotent. -/
theorem ItemNormalizer.norm_idem {act : Γ → U → U} {norm : U → U}
    (hn : ItemNormalizer act norm) (x : U) : norm (norm x) = norm x := by
  obtain ⟨γ, hγ⟩ := hn.representative x
  calc norm (norm x) = norm (act γ x) := congrArg norm hγ
    _ = norm x := hn.invariant γ x

/-- Tuples with the same normalized items have the same normal form. -/
theorem NF_eq_of_norm_comp_eq [LinearOrder β] (key : U → β) (norm : U → U)
    {f g : Fin n → U} (e : norm ∘ g = norm ∘ f) : NF key norm g = NF key norm f := by
  unfold NF
  rw [e]

/-- Sorting by an injective key does not depend on the order of the positions. -/
theorem sorted_perm_eq [LinearOrder β] {key : U → β} (hkey : Function.Injective key)
    (h : Fin n → U) (σ : Equiv.Perm (Fin n)) :
    (h ∘ σ) ∘ Tuple.sort (key ∘ (h ∘ σ)) = h ∘ Tuple.sort (key ∘ h) := by
  have e : ((key ∘ h) ∘ σ) ∘ Tuple.sort ((key ∘ h) ∘ σ) = (key ∘ h) ∘ Tuple.sort (key ∘ h) :=
    Tuple.comp_perm_comp_sort_eq_comp_sort
  funext i
  exact hkey (congrFun e i)

/-- The normal form is constant along a permutation of the positions. -/
theorem NF_perm [LinearOrder β] {key : U → β} (hkey : Function.Injective key) {norm : U → U}
    (f : Fin n → U) (σ : Equiv.Perm (Fin n)) : NF key norm (f ∘ σ) = NF key norm f := by
  unfold NF
  exact sorted_perm_eq hkey (norm ∘ f) σ

/-- The normal form is constant along a gauge move. -/
theorem NF_gauge [LinearOrder β] {key : U → β} {act : Γ → U → U} {norm : U → U}
    (hn : ItemNormalizer act norm) (f : Fin n → U) (c : Fin n → Γ) :
    NF key norm (fun i => act (c i) (f i)) = NF key norm f :=
  NF_eq_of_norm_comp_eq key norm (funext fun i => hn.invariant (c i) (f i))

/-- The normal form is constant along a move. -/
theorem NF_move [LinearOrder β] {key : U → β} (hkey : Function.Injective key)
    {act : Γ → U → U} {norm : U → U} (hn : ItemNormalizer act norm)
    {f g : Fin n → U} (h : Move act f g) : NF key norm f = NF key norm g := by
  cases h with
  | perm _ σ => exact Eq.symm (NF_perm hkey _ σ)
  | gauge _ c => exact Eq.symm (NF_gauge hn _ c)

/-- The normal form is constant on the classes of `TEquiv act`. -/
theorem NF_tequiv [LinearOrder β] {key : U → β} (hkey : Function.Injective key)
    {act : Γ → U → U} {norm : U → U} (hn : ItemNormalizer act norm)
    {f g : Fin n → U} (h : TEquiv act f g) : NF key norm f = NF key norm g := by
  unfold TEquiv at h
  induction h with
  | rel x y hxy => exact NF_move hkey hn hxy
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Every tuple is equivalent to its normal form: a gauge move to the normalized items, then a
permutation of the positions. -/
theorem tequiv_NF [LinearOrder β] {key : U → β} (_hkey : Function.Injective key)
    {act : Γ → U → U} {norm : U → U} (hn : ItemNormalizer act norm) (f : Fin n → U) :
    TEquiv act f (NF key norm f) := by
  have hr : ∀ i, ∃ γ, norm (f i) = act γ (f i) := fun i => hn.representative (f i)
  choose c hc using hr
  have e : (fun i => act (c i) (f i)) = norm ∘ f := funext fun i => (hc i).symm
  have h₁ : Move act f (norm ∘ f) := by
    rw [← e]
    exact Move.gauge f c
  have h₂ : Move act (norm ∘ f) (NF key norm f) :=
    Move.perm (norm ∘ f) (Tuple.sort (key ∘ norm ∘ f))
  exact Relation.EqvGen.trans (r := Move act) _ _ _
    (Relation.EqvGen.rel (r := Move act) _ _ h₁) (Relation.EqvGen.rel (r := Move act) _ _ h₂)

/-- The normal form is a canonicalization of `TEquiv act`: it is idempotent, decisive and
representative. -/
theorem canonicalization [LinearOrder β] {key : U → β} (hkey : Function.Injective key)
    {act : Γ → U → U} {norm : U → U} (hn : ItemNormalizer act norm) :
    Canonicalization (TEquiv (n := n) act) (NF (n := n) key norm) :=
  Canonicalization.of_invariant_representative (tequiv_equivalence act)
    (fun _ _ h => NF_tequiv hkey hn h) (fun f => tequiv_NF hkey hn f)

end LmnfNormal
