// Generated by make_groups.py from batches/0019/states.dl, lines 14-25, 33-79 and 128-144, verbatim. Do not edit: CI regenerates it and compares.
.decl space(s:symbol, size:number, copies:number, kind:symbol)
.input space
.decl tensor(t:symbol, role:symbol, stype:symbol, layer:number)
.input tensor
.decl axis(t:symbol, pos:number, s:symbol)
.input axis
.decl cons(op:symbol, s:symbol, role:symbol)
.input cons
.decl diag(op:symbol, sin:symbol, sout:symbol)
.input diag
.decl op(o:symbol, kind:symbol)
.input op

// ---- the library: the lattice of groups of changes of basis ------------------------------------------------------------------------------------------------------------
// Triv < Perm < SP (signed permutations) < SSP (a scalar times a signed permutation) < Mono (diagonal times permutation) < GL; SP < O < CO (a positive scalar times an
// orthogonal matrix) < GL; SSP < CO; Triv < Cplx (a complex scalar on every plane of the rotary embedding) < GL.
.decl elem(g:symbol)
elem("Triv"). elem("Perm"). elem("SP"). elem("SSP"). elem("O"). elem("CO"). elem("Mono"). elem("Cplx"). elem("GL").
.decl le0(a:symbol, b:symbol)
le0("Triv","Perm"). le0("Perm","SP"). le0("SP","SSP"). le0("SP","O"). le0("SP","Mono"). le0("O","CO"). le0("SSP","CO"). le0("SSP","Mono"). le0("Mono","GL"). le0("CO","GL").
le0("Triv","Cplx"). le0("Cplx","GL").
.decl le(a:symbol, b:symbol)
le(a,a) :- elem(a).
le(a,b) :- le0(a,b).
le(a,c) :- le(a,b), le0(b,c).
.decl lb(a:symbol, b:symbol, c:symbol)
lb(a,b,c) :- elem(a), elem(b), le(c,a), le(c,b).
.decl above(a:symbol, b:symbol, c:symbol)
above(a,b,c) :- lb(a,b,c), lb(a,b,d), le(c,d), c != d.
.decl glb(a:symbol, b:symbol, c:symbol)
glb(a,b,c) :- lb(a,b,c), !above(a,b,c).

// ---- the library: what a role allows --------------------------------------------------------------------------------------------------------------------------------
.decl compat(r:symbol, g:symbol)
compat("lin","GL").          // a space that enters a linear map: any invertible change, compensated in the map
compat("bilinear","GL").     // a pairing q . k: A on one side, A^-T on the other
compat("rmsnorm","O").       // the root mean square (epsilon > 0)
compat("rmsnorm0","CO").     // the root mean square with epsilon = 0: also a positive scale (measured by batch 0015's rank; not proved in Lean)
compat("rope","Cplx").       // the rotary embedding: what commutes with the rotations of the planes
compat("nl","Perm").         // an elementwise nonlinearity
compat("mono","Mono").       // an elementwise product with a linear branch: scalings and permutations
compat("replica","Perm").    // independent copies of a computation: permutations
compat("triv","Triv").       // positions and vocabulary

// the diagonal link of a norm weight: if it maps a space to the same space (the tied head reads the stream through the weight), only monomial changes preserve it; if it maps to
// another space, the changes of the stream are carried to it by conjugation with the weight, and the other space has the independent scalings that change the weight.
.decl ceff(op:symbol, s:symbol, r:symbol)
ceff(o,s,r) :- cons(o,s,r).
ceff(o,s,"mono") :- diag(o,s1,s2), s1 = s2, s = s1.
ceff(o,s2,"mono") :- diag(o,s1,s2), s1 != s2.

// ---- the derived group of each space -----------------------------------------------------------------------------------------------------------------------------------
.decl lower(s:symbol, g:symbol)
lower(s,g) :- ceff(_,s,r), compat(r,g).
lower(s,g) :- lower(s,g1), ceff(_,s,r), compat(r,g2), glb(g1,g2,g).
.decl strict(s:symbol, g:symbol)
strict(s,g) :- lower(s,g), lower(s,h), le(h,g), h != g.
.decl grp_of(s:symbol, g:symbol)
grp_of(s,g) :- lower(s,g), !strict(s,g).
.output grp_of

// ---- checks of the program and of the library (all must be empty) --------------------------------------------------------------------------------------------------------------
.decl has_glb(a:symbol, b:symbol)
has_glb(a,b) :- glb(a,b,_).
.decl no_glb(a:symbol, b:symbol)
no_glb(a,b) :- elem(a), elem(b), !has_glb(a,b).
.decl many_glb(a:symbol, b:symbol)
many_glb(a,b) :- glb(a,b,c), glb(a,b,d), c != d.
.decl has_group(s:symbol)
has_group(s) :- grp_of(s,_).
.decl ungrouped(s:symbol)
ungrouped(s) :- space(s,_,_,_), !has_group(s).
.decl two_groups(s:symbol)
two_groups(s) :- grp_of(s,g), grp_of(s,h), g != h.
.output no_glb
.output many_glb
.output ungrouped
.output two_groups

